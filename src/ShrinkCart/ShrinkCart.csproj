<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ShrinkCart</AssemblyName>
    <RootNamespace>ShrinkCart</RootNamespace>
    <Product>ShrinkCart</Product>
    <!-- 版本号唯一来源：构建时会校验 package/manifest.json 与 CHANGELOG.md 顶部版本与此一致。 -->
    <Version>0.3.2</Version>
    <BepInExPluginGuid>AngelcoMilk.ShrinkCart</BepInExPluginGuid>
    <BepInExPluginName>ShrinkCart</BepInExPluginName>
    <!-- 使用 publicize 后的 Assembly-CSharp 需要允许 unsafe（publicizer 会注入 IgnoresAccessChecksTo）。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="HarmonyX" Version="2.9.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- 游戏与依赖 DLL 只从本机路径引用（见 Directory.Build.props），不复制、不入库。 -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp" Publicize="true">
      <HintPath>$(REPOManagedDir)Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(REPOManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(REPOManagedDir)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(REPOManagedDir)UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(REPOManagedDir)UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(REPOManagedDir)UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(REPOManagedDir)PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(REPOManagedDir)PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(REPOManagedDir)Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ScalerCore">
      <HintPath>$(ScalerCoreDir)ScalerCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ShrinkCartCheckLocalReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(REPOManagedDir)Assembly-CSharp.dll')"
           Text="找不到 $(REPOManagedDir)Assembly-CSharp.dll。请复制 ShrinkCart.local.props.example 为 ShrinkCart.local.props 并设置 REPOGameDir。" />
    <Error Condition="!Exists('$(ScalerCoreDir)ScalerCore.dll')"
           Text="找不到 $(ScalerCoreDir)ScalerCore.dll。请在 R2ProfileDir 指向的 r2modman profile 中安装 Vippy-ScalerCore。" />
  </Target>

</Project>
